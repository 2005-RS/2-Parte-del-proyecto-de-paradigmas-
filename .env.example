# Copia este archivo a .env antes de arrancar.
# Las URLs WEB_* y DEMO_* las usa el navegador. Deben ser alcanzables
# desde los dispositivos de la clase, no los nombres internos de Docker.

POSTGRES_AUTH_USER=auth
POSTGRES_AUTH_PASSWORD=auth_dev_change_me
POSTGRES_AUTH_DB=auth

POSTGRES_ACTIVITIES_USER=activities
POSTGRES_ACTIVITIES_PASSWORD=activities_dev_change_me
POSTGRES_ACTIVITIES_DB=activities

AUTH_PORT=3001
ACTIVITIES_PORT=3002
WEB_PORT=8080
DEMO_PORT=8081
GRAFANA_PORT=3005
PROMETHEUS_PORT=9090

JWT_ISSUER=profelink-auth
JWT_AUDIENCE=activities-api
JWT_EXPIRES_IN=8h

SEED=true
MAX_PLAYERS_PER_SESSION=40
UPLOAD_MAX_BYTES=2097152

# URLs que abre el navegador. En local quedan en localhost.
# En el VPS se cambian por la IPv4 pública, como en el README.
WEB_AUTH_URL=http://localhost:3001
WEB_ACTIVITIES_URL=http://localhost:3002
WEB_WS_URL=http://localhost:3002
DEMO_AUTH_URL=http://localhost:3001
DEMO_ACTIVITIES_URL=http://localhost:3002
WEB_URL=http://localhost:8080

# Orígenes permitidos para el frontend y el cliente adicional.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_change_me

# Ponlo en true solo si la red intercepta HTTPS y Docker no puede descargar dependencias.
INSECURE_TLS=false

# Docker Hub. Cambia el espacio por el de tu equipo antes de publicar.
DOCKERHUB_NAMESPACE=2005rs
IMAGE_TAG=1.0.0

# Solo se usan con el perfil edge, al publicar en un VPS.
AUTH_DOMAIN=auth.example.com
ACTIVITIES_DOMAIN=actividades.example.com
WEB_DOMAIN=aula.example.com
DEMO_DOMAIN=cliente.example.com
ACME_EMAIL=curso@example.com
