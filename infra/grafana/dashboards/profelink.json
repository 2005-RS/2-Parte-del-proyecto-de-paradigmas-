{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "Solicitudes HTTP por servicio",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service_name) (rate(profelink_http_requests_total[1m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Respuestas de la partida",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (result) (rate(profelink_answers_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "type": "stat",
      "title": "Conexiones WebSocket activas",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(profelink_ws_connections)",
          "legendFormat": "conexiones"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Salas iniciadas",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "sum(profelink_sessions_started_total)",
          "legendFormat": "salas"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Respuestas rechazadas",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(profelink_answers_total{result!=\"accepted\"})",
          "legendFormat": "rechazadas"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["profelink"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "ProfeLink actividades",
  "uid": "profelink-actividades",
  "version": 1
}
